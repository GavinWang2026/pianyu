# 第三方资产：由发布脚本 / NOTICE.md 管理，不计入自研源码仓库。
# 目的：让 git 历史成为「哪些代码是 Hyht-Team 自己写的」的干净证据。
/vendor/
/runtime/
/models/
/.venv-asr/
/.venv/
/.venv-asr-test/

# 凭据：cookie 文件绝不入库（cookies/README.md 说明文档要保留）
/cookies/*.txt
/cookies/*.json
/cookies/*.db
/cookies/*.rtf
/cookies/*.har
*.rtf
*.har

# 本机配置、运行产物、缓存
/config.json
/outputs/
/downloads/
/logs/
*.egg-info/
/dist/
/build/
/uploads/
/.uploads/
__pycache__/
*.py[cod]
.DS_Store
*.log
/tmp/

# 可写状态目录（Cookie 副本等，绝不进包/进库）
/.state/

# 本地临时目录（验证脚本 / 覆盖率用）
/.tmpcov/
/.coverage_r2b

# 联网验证用的临时素材（不进包、不进库）
/.tmpmedia/

# 本地审计报告、覆盖率与分享包（证据留本地，不入库）
/evidence/
/.coverage
/.workbuddy/
/.trae-html-share-packages/

# 内部资产/许可文档：保留在本机，不随开源仓库发布
/作者信息
/内部核查清单
