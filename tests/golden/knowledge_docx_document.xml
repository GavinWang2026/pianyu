<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><w:body><w:p><w:pPr><w:pStyle w:val="Caption"/></w:pPr><w:r><w:t xml:space="preserve">AVD Flagship 知识稿</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t xml:space="preserve">R1 验收素材</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Subtitle"/></w:pPr><w:r><w:rPr><w:i/></w:rPr><w:t xml:space="preserve">生成器：AVD Flagship · <STAMP></w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve"></w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">摘要</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">摘要一句。</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">关键词：索引、知识管理</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">正文</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">今天讲本地优先的知识管理，第一步是把素材入库，第二步才是建索引。</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">素材入库之后要建倒排索引，索引质量直接决定检索速度与命中率。</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">检索速度取决于索引结构本身，而不是机器性能，这点要特别强调。</w:t></w:r></w:p><w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:headerReference w:type="default" r:id="rIdHeader1"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1418" w:bottom="1440" w:left="1418" w:header="851" w:footer="992" w:gutter="0"/></w:sectPr></w:body></w:document>